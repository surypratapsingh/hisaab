<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Sideloaded build only: reads SMS history on the phone. See decisions.md, 2026-09-26. -->
  <uses-permission android:name="android.permission.READ_SMS" />
  <application>
    <!-- Reads bank and UPI alerts as they arrive, instead of READ_SMS.
         The user turns it on in Settings > Notification access. -->
    <service
      android:name="expo.modules.alertcapture.AlertListenerService"
      android:label="Hisaab"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
